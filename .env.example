# Copy this file to .env and edit. Never commit the real .env file.

# Folder where the company's existing PDFs live (used by POST /index-folder)
LIBRARY_DIR=data/library

# Local embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Gemini API key (get one at aistudio.google.com/apikey). Keep it ONLY in .env
LLM_API_KEY=your-key-here

# Optional: leave empty to auto-pick the newest stable Gemini flash model.
# On the free tier "gemini-3.5-flash-lite" has the most daily requests (about 500 per day).
LLM_MODEL=

# Optional: passages scoring below this are ignored (tuned with the benchmark)
MIN_SCORE=0.35

# Search mode: hybrid (meaning + keywords, default) or semantic (meaning only)
SEARCH_MODE=hybrid

# How long Gemini "thinks" before answering: minimal, low, medium, high (or empty = default).
# minimal gives much faster first words. If the model does not accept it, the app retries without.
LLM_THINKING=minimal
